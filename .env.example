NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-06
# Token with editor/publish access. Only needed to run: npm run studio:seed
SANITY_API_TOKEN=

# --- Email delivery for the contact form (Nodemailer SMTP) ---
# The "from" address will be SMTP_USER and enquiries are delivered to
# CONTACT_RECIPIENT_EMAIL below.
#
# Using Gmail as the sender? Turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Studio inbox that receives every enquiry (the from/to are separate).
CONTACT_RECIPIENT_EMAIL=picturethemoments42@gmail.com
